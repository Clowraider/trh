DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=trh
DB_USER=postgres
DB_PASSWORD=ponetuclave

# Selección editorial
PUBLICABLES_WINDOW_DAYS=7
HORAS_PENALIZACION_PUBLICADO=6

# Generación con IA (publicador.py) - proveedor compatible con OpenAI
OPENAI_API_KEY=ponetuapikey
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ARTICLE_WRITER_MAX_TOKENS=4000
ARTICLE_WRITER_SYSTEM_PROMPT_FILE=prompts/article_writer_system_prompt.txt
ARTICLE_WRITER_USER_PROMPT_FILE=prompts/article_writer_user_prompt.txt
ARTICLE_CATEGORIES_FILE=prompts/article_categories.json
EDITOR_JEFE_SYSTEM_PROMPT_FILE=prompts/editor_jefe_system_prompt.txt
EDITORIAL_CONTROL_SYSTEM_PROMPT_FILE=prompts/editorial_control_system_prompt.txt
EDITORIAL_CONTROL_RULES_FILE=prompts/editorial_control_rules.json

# Watermark de imágenes (publicapress.py)
WATERMARK_ENABLED=true
WATERMARK_MODE=text
WATERMARK_TEXT=tu_texto_marca_de_agua
WATERMARK_OPACITY=0.35
WATERMARK_POSITION=bottom_right
WATERMARK_MARGIN=24
# Para logo/both: ruta local a PNG transparente
WATERMARK_LOGO_PATH=

OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_LIMIT=1000
EMBEDDING_COMMIT_EVERY=1
EMBEDDING_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=1.5

# Seguridad de sesión (obligatorio en producción)
SECRET_KEY=cambia-esto-por-una-clave-segura-y-aleatoria-en-produccion
SESSION_LIFETIME_HOURS=24
AUTH_REQUIRED=True
