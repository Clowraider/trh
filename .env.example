DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=trh
DB_USER=postgres
DB_PASSWORD=ponetuclave

# Selección editorial
PUBLICABLES_WINDOW_DAYS=7
HORAS_PENALIZACION_PUBLICADO=6

# Generación con IA (publicador.py)
OPENROUTER_API_KEY=ponetuapikey
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL_PRIMARY=openrouter/free
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-v4-flash

# Publicación WordPress (publicapress.py)
WP_URL=https://tusitio.com
WP_USERNAME=tuusuario
WP_APP_PASSWORD=tu-app-password

# Watermark de imágenes (publicapress.py)
WATERMARK_ENABLED=true
WATERMARK_MODE=text
WATERMARK_TEXT=TRH.com.ar
WATERMARK_OPACITY=0.35
WATERMARK_POSITION=bottom_right
WATERMARK_MARGIN=24
# Para logo/both: ruta local a PNG transparente
WATERMARK_LOGO_PATH=

OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_LIMIT=1000
EMBEDDING_COMMIT_EVERY=100
EMBEDDING_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=1.5
